# Домен (или поддомен) релея. Его A-запись должна указывать на IP этого сервера.
# Пример: tg-relay.example.com
RELAY_DOMAIN=
# Секретный префикс пути. Сгенерировать: openssl rand -hex 16
# Без него релей отвечает 404 на всё.
RELAY_SECRET=
# (необязательно) Пускать только с этих IP, через пробел: IP серверов, где работают боты.
# Пусто = с любых IP.
RELAY_ALLOW_IPS=
