# ===== Обязательно =====
# Токен бота от @BotFather
BOT_TOKEN=
# Название салона (используется при первом запуске)
SALON_NAME=Мой салон
# Секретный ключ, которым бот ходит в API. Любая длинная случайная строка: openssl rand -hex 24
TENANT_API_KEY=
# Пароль базы данных: openssl rand -hex 16
DB_PASSWORD=
# Часовой пояс салона
TZ=Europe/Moscow

# ===== Необязательно =====
# Telegram ID админа. Можно не заполнять: админ входит по ссылке, которую выдаёт установка
ADMIN_CHAT_ID=
# Сколько минут ждать чек о предоплате, прежде чем снять бронь
PREPAY_TIMEOUT_MIN=30
# Сколько будущих записей одновременно может держать один клиент
MAX_ACTIVE_BOOKINGS=3
# На сколько дней вперёд открыта запись
BOOKING_HORIZON_DAYS=14
# Шаг сетки времени в минутах (30 = 10:00, 10:30, 11:00…)
SLOT_STEP_MIN=30
# Мониторинг ошибок (sentry.io), если нужен
SENTRY_DSN=
