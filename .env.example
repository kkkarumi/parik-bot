# ===== Обязательно =====
# Токен бота от @BotFather
BOT_TOKEN=
# Название салона (используется при первом запуске)
SALON_NAME=Мой салон
# Секретный ключ, которым бот ходит в API. Любая длинная случайная строка: openssl rand -hex 24
TENANT_API_KEY=
# Пароль базы данных: openssl rand -hex 16
DB_PASSWORD=
# Часовой пояс салона
TZ=Europe/Moscow

# ===== Необязательно =====
# Адрес Telegram Bot API. Пусто = напрямую (https://api.telegram.org).
# Сервер в РФ и Telegram оттуда недоступен — адрес релея (relay/README.md), без «/» на конце:
# TELEGRAM_API_BASE=https://tg-relay.example.com/СЕКРЕТ
TELEGRAM_API_BASE=
# Telegram ID админа. Можно не заполнять: админ входит по ссылке, которую выдаёт установка
ADMIN_CHAT_ID=
# Сколько минут ждать чек о предоплате, прежде чем снять бронь
PREPAY_TIMEOUT_MIN=30
# Сколько будущих записей одновременно может держать один клиент
MAX_ACTIVE_BOOKINGS=3
# На сколько дней вперёд открыта запись
BOOKING_HORIZON_DAYS=14
# Шаг сетки времени в минутах (30 = 10:00, 10:30, 11:00…)
SLOT_STEP_MIN=30
# За сколько минут до начала слот закрывается для записи. 0 = можно записаться до самого начала.
# Рекомендуем 60: мастер успеет увидеть запись.
MIN_LEAD_MIN=0
# До скольких минут до визита клиент может сам отменить запись в боте (ровно за N минут ещё можно).
# 0 = без ограничения. Рекомендуем 120. Позже — бот попросит позвонить в салон.
# Мастер и админ отменяют всегда. Неоплаченную бронь (предоплата) клиент снимает всегда.
CANCEL_BEFORE_MIN=0
# Мониторинг ошибок (sentry.io) для бэкенда и бота, если нужен. Телефоны, токены и ключи
# вырезаются перед отправкой, но сервис за рубежом — см. docs/legal/поручение_обработки_пдн.md
SENTRY_DSN=
